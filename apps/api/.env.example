# Every variable the API reads. Leave optional ones empty; never commit real values.

# ── App ───────────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV="development"                   # "production" on Cloud Run
FRONTEND_URL="http://localhost:5173"     # web app origin (CORS allowlist, OAuth redirects)
API_BASE_URL="http://localhost:3001"     # public API origin (OAuth callbacks, local upload URLs)

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=""                            # required; also keys OTP hashes and OAuth state
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"
OWNER_PHONE=""                           # phone that signs in as the platform owner
OWNER_EMAIL=""                           # comma-separated Google emails (verified) that sign in as the platform owner

# ── Phone OTP ─────────────────────────────────────────────────────────────────
# Production refuses phone sign-in (503) until a provider is configured.
# NODE_ENV=development skips sending and accepts 1234.
OTP_PROVIDER=""                          # "twilio" | "msg91"
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""
MSG91_AUTH_KEY=""
MSG91_TEMPLATE_ID=""

# ── Internal endpoints ────────────────────────────────────────────────────────
ADMIN_SECRET=""                          # bearer for /v1/admin/scraper/*; unset = closed in production
CRON_SECRET=""                           # bearer for /v1/cron/publish; unset = closed in production

# ── Firestore (database) ──────────────────────────────────────────────────────
GOOGLE_CLOUD_PROJECT=""                  # or GCP_PROJECT
GCP_PROJECT=""
FIRESTORE_DATABASE_ID="(default)"
GOOGLE_APPLICATION_CREDENTIALS=""        # service account JSON path for local runs against Firestore
FIRESTORE_EMULATOR_HOST=""               # e.g. localhost:8080
FORCE_FIRESTORE=""                       # "true" to use Firestore outside Cloud Run
FIRESTORE_MEMORY=""                      # "true" for the in-memory store (ignored in production)

# Prisma schema tooling only (prisma generate); the API itself runs on Firestore.
DATABASE_URL=""

# ── Redis (optional: BullMQ workers and cache) ────────────────────────────────
REDIS_URL=""

# ── File storage ──────────────────────────────────────────────────────────────
# GCS_BUCKET wins, then S3/R2, else local disk (dev only).
GCS_BUCKET=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="auto"
S3_BUCKET=""
S3_ENDPOINT=""                           # R2 endpoint; empty for AWS S3
CLOUDFRONT_DOMAIN=""                     # optional public CDN domain

# ── AI: Gemini ────────────────────────────────────────────────────────────────
# Model choices saved in Admin → APIs & models win over these; these win over the built-in defaults.
GEMINI_API_KEY=""
GEMINI_TEXT_MODEL=""                     # default gemini-3.8-flash
GEMINI_IMAGE_MODEL=""                    # default gemini-3.1-flash-image
GEMINI_VIDEO_MODEL=""                    # default gemini-omni-1.1-flash
GEMINI_OMNI_RESOLUTION=""                # "360p" | "720p" | "1080p" | "4k"; default 720p (Veo uses 720p or 1080p)
GEMINI_SKIP_SCENE_EXTRACTION=""          # "true" to skip the scene-planning call

# ── Reels ─────────────────────────────────────────────────────────────────────
VIDEO_DEFAULT_ENGINE=""                  # "veo" (AI video) | "kenburns" (quick render); default AI video when a Gemini key is set
VIDEO_RENDER_INLINE=""                   # "true" to start renders on the instance that queued them (always-allocated CPU); else the cron runs them
VIDEO_RENDER_DEADLINE_MS=""              # overall budget for one AI video render; default 230000
REEL_DAILY_LIMIT="10"                    # AI video reels per dealer per day (UTC)
REEL_QUICK_DAILY_LIMIT="30"              # quick-render reels per dealer per day (UTC)

# ── AI: other providers (optional fallbacks) ──────────────────────────────────
GROQ_API_KEY=""
GROQ_MODEL=""                            # default llama-3.3-70b-versatile
OPENROUTER_TEXT_API_KEY=""
OPENROUTER_TEXT_MODEL=""
OPENROUTER_IMAGE_API_KEY=""
OPENROUTER_IMAGE_MODEL=""
OPENAI_API_KEY=""
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_API_TOKEN=""
OLLAMA_HOST=""                           # default http://localhost:11434
OLLAMA_MODEL=""                          # default llama3.2
REMOVE_BG_API_KEY=""

# ── Meta (Facebook / Instagram) ───────────────────────────────────────────────
META_APP_ID=""
META_APP_SECRET=""                       # also verifies webhook signatures
META_REDIRECT_URI=""                     # e.g. https://<api>/v1/auth/facebook/callback
META_WEBHOOK_VERIFY_TOKEN=""             # required in production for webhook verification
META_USER_ACCESS_TOKEN=""                # optional: Graph API for /v1/admin/scraper/seed

# ── Google OAuth ──────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI=""                   # default ${API_BASE_URL}/v1/auth/google/callback

# ── Billing (Razorpay) ────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
